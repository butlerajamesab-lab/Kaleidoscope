{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminari.org/kaleidoscope/contracts/legislative-consequence-edge.v1.json",
  "title": "Legislative Consequence Edge v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_id","graph_version","engine_id","engine_version","scenario_id","source_delta_bundle_id","source_delta_bundle_hash","edge_count","edges","unresolved_conditions","graph_hash"],
  "properties": {
    "graph_id": {"type": "string", "pattern": "^lcgraph-[a-z0-9-]+-v[0-9]+$"},
    "graph_version": {"const": "1.0.0"},
    "engine_id": {"const": "legislative_consequence_engine"},
    "engine_version": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "source_delta_bundle_id": {"type": "string", "minLength": 1},
    "source_delta_bundle_hash": {"$ref": "#/$defs/hash"},
    "edge_count": {"type": "integer", "minimum": 1},
    "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
    "unresolved_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "graph_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id","locator"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id","from_delta_ids","to_node_id","relationship_type","causal_state","evidence_ceiling","explanation","source_bindings","unresolved_conditions","edge_hash"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^lce-[a-z0-9-]+$"},
        "from_delta_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^lcd-[a-z0-9-]+$"}, "uniqueItems": true},
        "to_node_id": {"type": "string", "minLength": 1},
        "relationship_type": {"enum": ["direct_legal_effect","necessary_operational_effect","historical_analogue","jurisdictional_fragmentation","possible_downstream_effect","preserved_invariant","unresolved_relationship"]},
        "causal_state": {"enum": ["directly_prescribed","logically_necessary","historically_observed","supported_inference","hypothesis_only","causation_not_asserted"]},
        "evidence_ceiling": {"enum": ["direct_text","logical_necessity","historical_record","supported_inference","hypothesis_only"]},
        "explanation": {"type": "string", "minLength": 1},
        "source_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
        "unresolved_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "edge_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
