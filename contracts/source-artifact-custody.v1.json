{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminari.org/kaleidoscope/contracts/source-artifact-custody.v1.json",
  "title": "Kaleidoscope Source Artifact Custody v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "custody_contract_version",
    "custody_record_kind",
    "custody_manifest_id",
    "source_artifact_id",
    "source_file_name",
    "sha256",
    "byte_length",
    "source_role",
    "source_use_state",
    "custody_scope",
    "content_owner_state",
    "upstream_binding_state",
    "upstream_platform",
    "upstream_object_type",
    "upstream_object_id",
    "no_upstream_ownership_inference",
    "custody_hash"
  ],
  "properties": {
    "custody_contract_version": {"const": "1.0.0"},
    "custody_record_kind": {"const": "source_artifact_custody"},
    "custody_manifest_id": {"type": "string", "minLength": 1},
    "source_artifact_id": {"type": "string", "minLength": 1},
    "source_file_name": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_length": {"type": "integer", "minimum": 0},
    "source_role": {"type": "string", "minLength": 1},
    "source_use_state": {"type": "string", "minLength": 1},
    "custody_scope": {"const": "artifact_identity_and_provenance_only"},
    "content_owner_state": {"const": "not_asserted"},
    "upstream_binding_state": {"const": "not_declared"},
    "upstream_platform": {"type": "null"},
    "upstream_object_type": {"type": "null"},
    "upstream_object_id": {"type": "null"},
    "no_upstream_ownership_inference": {"const": true},
    "custody_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
