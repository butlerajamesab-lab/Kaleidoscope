{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminari.org/kaleidoscope/contracts/civic-genome-snapshot-binding.v1.json",
  "title": "Kaleidoscope Civic Genome Snapshot Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "binding_version",
    "source_owner",
    "source_schema_id",
    "source_contract_id",
    "source_contract_version",
    "source_snapshot_id",
    "source_snapshot_hash",
    "source_export_receipt_id",
    "source_export_receipt_hash",
    "source_as_of",
    "source_scope",
    "source_completeness_state",
    "source_component_count",
    "component_manifest",
    "verification_mapping_state",
    "binding_state",
    "binding_errors",
    "no_mutation"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_version": {
      "enum": ["1.0.0", "1.1.0"]
    },
    "source_owner": {
      "const": "lighthouse/civic_genome"
    },
    "source_schema_id": {
      "const": "https://luminari.org/civic-genome/contracts/external-snapshot.v1.schema.json"
    },
    "source_contract_id": {
      "const": "civic_genome.external_snapshot.v1"
    },
    "source_contract_version": {
      "const": "1.0.0"
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_export_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "source_export_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "source_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_type", "scope_ids", "jurisdiction_codes"],
      "properties": {
        "scope_type": {
          "enum": ["bill", "family", "jurisdiction", "comparison_matrix", "bounded_set"]
        },
        "scope_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "jurisdiction_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_completeness_state": {
      "enum": ["complete", "bounded_complete", "incomplete"]
    },
    "source_component_count": {
      "type": "integer",
      "minimum": 0
    },
    "component_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_component_id",
          "source_component_type",
          "source_component_hash",
          "source_canonical_record_id",
          "source_inclusion_state",
          "source_verification",
          "source_unresolved_conditions",
          "kaleidoscope_component_id",
          "component_mapping_state"
        ],
        "properties": {
          "source_component_id": {
            "type": "string",
            "pattern": "^civic_genome:"
          },
          "source_component_type": {
            "enum": [
              "family",
              "bill",
              "trait",
              "relationship",
              "lineage_edge",
              "event",
              "momentum_component",
              "momentum_snapshot",
              "comparison_matrix",
              "comparison_state_cell",
              "unresolved_family_candidate"
            ]
          },
          "source_component_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_canonical_record_id": {
            "type": "string",
            "minLength": 1
          },
          "source_inclusion_state": {
            "enum": ["current", "historical", "unresolved", "rejected"]
          },
          "source_verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["owner_service", "state", "receipt_id", "evidence_hash", "mapping_state"],
              "properties": {
                "owner_service": {
                  "enum": ["docket", "rosetta", "atlas", "prism", "civic_genome"]
                },
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "receipt_id": {
                  "type": ["string", "null"]
                },
                "evidence_hash": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "mapping_state": {
                  "const": "source_native_preserved"
                }
              }
            }
          },
          "mapped_verification": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_owner_service",
                "source_state",
                "source_receipt_id",
                "source_evidence_hash",
                "source_mapping_state",
                "mapped_verification_state",
                "mapping_rule_id",
                "mapping_rule_version",
                "mapping_reason"
              ],
              "properties": {
                "source_owner_service": { "type": "string", "minLength": 1 },
                "source_state": { "type": "string", "minLength": 1 },
                "source_receipt_id": { "type": ["string", "null"] },
                "source_evidence_hash": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_mapping_state": { "const": "source_native_preserved" },
                "mapped_verification_state": {
                  "enum": ["primary_adjacent", "locator_only", "unresolved", "contradicted"]
                },
                "mapping_rule_id": {
                  "const": "kaleidoscope.civic_genome_verification_mapping"
                },
                "mapping_rule_version": { "const": "1.0.0" },
                "mapping_reason": { "type": "string", "minLength": 1 }
              }
            }
          },
          "source_unresolved_conditions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "kaleidoscope_component_id": {
            "type": ["string", "null"]
          },
          "component_mapping_state": {
            "enum": [
              "unmapped",
              "mapped_by_declared_rule",
              "verification_mapped_identity_unbound",
              "rejected"
            ]
          }
        }
      }
    },
    "verification_mapping_state": {
      "enum": ["unmapped_source_native", "mapped_by_declared_rule"]
    },
    "verification_mapping_rule_id": {
      "type": ["string", "null"]
    },
    "verification_mapping_rule_version": {
      "type": ["string", "null"]
    },
    "binding_state": {
      "enum": ["accepted", "rejected", "unresolved"]
    },
    "binding_errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "imported_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "no_mutation": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_mapping_state": { "const": "mapped_by_declared_rule" }
        }
      },
      "then": {
        "required": ["verification_mapping_rule_id", "verification_mapping_rule_version"],
        "properties": {
          "verification_mapping_rule_id": { "type": "string", "minLength": 1 },
          "verification_mapping_rule_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding_state": { "const": "accepted" }
        }
      },
      "then": {
        "properties": {
          "verification_mapping_state": { "const": "mapped_by_declared_rule" },
          "binding_errors": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "binding_version": { "const": "1.1.0" }
        }
      },
      "then": {
        "properties": {
          "component_manifest": {
            "items": {
              "required": ["mapped_verification"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_completeness_state": { "const": "incomplete" }
        }
      },
      "then": {
        "properties": {
          "binding_state": { "const": "unresolved" },
          "binding_errors": { "minItems": 1 }
        }
      }
    }
  ]
}