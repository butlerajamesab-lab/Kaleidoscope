{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminari.org/kaleidoscope/contracts/legislative-consequence-impact-surface.v1.json",
  "title": "Kaleidoscope Legislative Consequence Impact Surface v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "impact_surface_version",
    "engine_id",
    "engine_version",
    "scenario_id",
    "source_consequence_graph_id",
    "source_consequence_graph_hash",
    "source_structural_delta_bundle_id",
    "source_structural_delta_bundle_hash",
    "rule_manifest_id",
    "rule_manifest_hash",
    "touched_actor_count",
    "touched_actor_ids",
    "impact_item_count",
    "effect_class_counts",
    "impact_items",
    "deferred_reference_count",
    "deferred_references",
    "unresolved_conditions",
    "atlas_historical_comparison_executed",
    "lighthouse_accountability_executed",
    "checklist_instantiated",
    "no_mutation",
    "database_write_count",
    "impact_surface_hash"
  ],
  "properties": {
    "impact_surface_version": {"const": "1.0.0"},
    "engine_id": {"const": "legislative_consequence_impact_surface"},
    "engine_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "source_consequence_graph_id": {"type": "string", "minLength": 1},
    "source_consequence_graph_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_structural_delta_bundle_id": {"type": "string", "minLength": 1},
    "source_structural_delta_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule_manifest_id": {"const": "legislative_consequence_impact_surface_classification.v1"},
    "rule_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "touched_actor_count": {"type": "integer", "minimum": 0},
    "touched_actor_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "impact_item_count": {"type": "integer", "minimum": 0},
    "effect_class_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal", "operational", "economic", "administrative"],
      "properties": {
        "legal": {"type": "integer", "minimum": 0},
        "operational": {"type": "integer", "minimum": 0},
        "economic": {"type": "integer", "minimum": 0},
        "administrative": {"type": "integer", "minimum": 0}
      }
    },
    "impact_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "impact_id",
          "source_edge_id",
          "from_delta_ids",
          "effect_classes",
          "touched_actor_ids",
          "to_node_id",
          "relationship_type",
          "causal_state",
          "evidence_ceiling",
          "effect_statement",
          "source_bindings",
          "unresolved_conditions",
          "no_new_causal_claim",
          "impact_hash"
        ],
        "properties": {
          "impact_id": {"type": "string", "minLength": 1},
          "source_edge_id": {"type": "string", "minLength": 1},
          "from_delta_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "effect_classes": {
            "type": "array",
            "items": {"enum": ["legal", "operational", "economic", "administrative"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "touched_actor_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "to_node_id": {"type": "string", "minLength": 1},
          "relationship_type": {"type": "string", "minLength": 1},
          "causal_state": {"type": "string", "minLength": 1},
          "evidence_ceiling": {"type": "string", "minLength": 1},
          "effect_statement": {"type": "string", "minLength": 1},
          "source_bindings": {"type": "array"},
          "unresolved_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "no_new_causal_claim": {"const": true},
          "impact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "deferred_reference_count": {"type": "integer", "minimum": 0},
    "deferred_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_edge_id", "relationship_type", "defer_reason", "source_bindings", "unresolved_conditions"],
        "properties": {
          "source_edge_id": {"type": "string", "minLength": 1},
          "relationship_type": {"const": "historical_analogue"},
          "defer_reason": {"const": "historical_comparison_reserved_for_stage_4_atlas"},
          "source_bindings": {"type": "array"},
          "unresolved_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "unresolved_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "atlas_historical_comparison_executed": {"const": false},
    "lighthouse_accountability_executed": {"const": false},
    "checklist_instantiated": {"const": false},
    "no_mutation": {"const": true},
    "database_write_count": {"const": 0},
    "impact_surface_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
